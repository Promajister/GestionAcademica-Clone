generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum EstadoPractica {
  EN_CURSO   @map("En Curso")
  APROBADO   @map("Aprobado")
  REPROBADO  @map("Reprobado")
}

enum EstadoActividad {
  PENDIENTE
  APROBADA
  OBSERVADA
}

enum TipoCentro {
  PARTICULAR
  PARTICULAR_SUBVENCIONADO @map("PARTICULAR SUBVENCIONADO")
  SLEP
  NO_CONVENCIONAL
}

enum TipoTutor {
  Supervisor
  Tallerista
}

enum TipoPregunta {
  ABIERTA
  CERRADA
}

/////////////////////////////////
//     MODELOS PRINCIPALES
/////////////////////////////////

model Estudiante {
  rut                  String    @id
  nombre               String
  genero               String?
  anio_nacimiento      DateTime?
  anio_ingreso         Int?
  plan                 String?
  avance               Float?
  puntaje_ponderado    Float?
  puntaje_psu          Float?
  promedio             Float?
  fono                 Int?
  email                String?
  direccion            String?
  sistema_ingreso      String?
  numero_inscripciones Int?

  practicas Practica[]
  historial HistorialEvento[]

  @@map("estudiante")
}

model Practica {
  id            Int             @id @default(autoincrement())
  estado        EstadoPractica
  nota_final    Float?
  fecha_inicio  DateTime
  fecha_termino DateTime?
  tipo          String?

  estudianteRut String
  estudiante    Estudiante      @relation(fields: [estudianteRut], references: [rut])

  centroId Int
  centro   CentroEducativo      @relation(fields: [centroId], references: [id])

  practicaColaboradores PracticaColaborador[]
  practicaTutores       PracticaTutor[]
  observaciones         Observacion[]

  @@map("practica")
}

model CentroEducativo {
  id                      Int         @id @default(autoincrement())
  nombre                  String
  region                  String?
  comuna                  String?
  direccion               String?
  telefono                Int?
  correo                  String?
  tipo                    TipoCentro?
  convenio                String?
  url_rrss                String?
  fecha_inicio_asociacion DateTime?

  practicas    Practica[]
  trabajadores TrabajadorEduc[]

  @@map("centro_educativo")
}

model TrabajadorEduc {
  id       Int     @id @default(autoincrement())
  rut      String  @unique
  nombre   String
  rol      String?
  correo   String?
  telefono Int?

  centroId Int
  centro   CentroEducativo @relation(fields: [centroId], references: [id], onDelete: Cascade)

  @@map("trabajador_educ")
}

model Colaborador {
  id                 Int      @id @default(autoincrement())
  rut                String   @unique
  nombre             String
  correo             String?
  direccion          String?
  telefono           Int?
  universidad_egreso String?

  cargos                 Cargo[]
  practicaColaboradores  PracticaColaborador[]

  @@map("colaborador")
}

model Actividad {
  id               Int      @id @default(autoincrement())
  mes              String
  nombre_actividad String
  estudiantes      String?
  terceros_asistieron Boolean @default(false)
  fecha            DateTime
  horario          String?
  lugar            String?
  archivo_adjunto  String?

  @@map("actividad")
}


model Usuario {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  nombre    String
  role      String
  rolId     Int?
  rol       Rol?     @relation(fields: [rolId], references: [id])
  activo    Boolean  @default(true)
  fotoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resetTokens PasswordResetToken[]
  refreshTokens RefreshToken[]
}

model Rol {
  id       Int      @id @default(autoincrement())
  clave    String   @unique
  nombre   String?
  usuarios Usuario[]
  permisos Permiso[] @relation("RolPermisos")

  @@map("rol")
}

model Permiso {
  id          Int    @id @default(autoincrement())
  clave       String @unique
  descripcion String?
  roles       Rol[]  @relation("RolPermisos")

  @@map("permiso")
}


/////////////////////////////////////
//    NUEVO MODELO: ENCUESTA SEMESTRE
/////////////////////////////////////

model EncuestaSemestre {
  id                      Int                      @id @default(autoincrement())
  anio                    Int
  semestre                Int
  archivo_adjunto         String?

  encuestasEstudiantes    EncuestaEstudiante[]
  encuestasColaboradores  EncuestaColaborador[]

  @@map("encuesta_semestre")
  @@unique([anio, semestre], name: "anio_semestre_unique")

}

/////////////////////////////////////
//    NUEVO MODELO: token de password
/////////////////////////////////////

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  usuario   Usuario  @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  used      Boolean  @default(false)

  @@map("password_reset_tokens")
}

model RefreshToken {
  id         String   @id // jti
  userId     Int
  usuario    Usuario  @relation(fields: [userId], references: [id])
  hashedToken String
  expiresAt  DateTime
  revoked    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("refresh_tokens")
  @@index([userId])
}


/////////////////////////////////////
//   ENCUESTAS A ESTUDIANTES
/////////////////////////////////////

model EncuestaEstudiante {
  id                 Int       @id @default(autoincrement())
  nombre_estudiante  String
  nombre_tallerista  String?
  nombre_centro      String?
  nombre_colaborador String?
  fecha              DateTime?
  observacion String? @db.Text
  tipo_practica               String?
  nombre_docente_colaborador_opcional Int?


  semestreId Int?
  semestre   EncuestaSemestre? @relation(fields: [semestreId], references: [id], onDelete: Cascade)

  items      ItemEncuestaEstudiante[]
  respuestas RespuestaSeleccionada[]

  @@map("encuesta_estudiante")
}

model ItemEncuestaEstudiante {
  id         Int    @id @default(autoincrement())
  encuestaId Int
  titulo     String
  orden      Int?

  encuesta  EncuestaEstudiante @relation(fields: [encuestaId], references: [id], onDelete: Cascade)
  preguntas Pregunta[]

  @@map("item_encuesta_estudiante")
}

/////////////////////////////////////
//   ENCUESTAS A COLABORADORES
/////////////////////////////////////

model EncuestaColaborador {
  id                 Int      @id @default(autoincrement())
  nombre_colaborador String
  nombre_colegio     String?
  observacion String? @db.Text
  tipo_practica      String?
  fecha              DateTime?
  
  semestreId Int?
  semestre   EncuestaSemestre? @relation(fields: [semestreId], references: [id], onDelete: Cascade)

  items      ItemEncuestaColaborador[]
  respuestas RespuestaSeleccionada[]

  @@map("encuesta_colaborador")
}

model ItemEncuestaColaborador {
  id         Int    @id @default(autoincrement())
  encuestaId Int
  titulo     String
  orden      Int?

  encuesta  EncuestaColaborador @relation(fields: [encuestaId], references: [id], onDelete: Cascade)
  preguntas Pregunta[]

  @@map("item_encuesta_colaborador")
}

/////////////////////////////////////
//   PREGUNTAS, ALTERNATIVAS Y RESPUESTAS
/////////////////////////////////////

model Pregunta {
  id               Int     @id @default(autoincrement())
  descripcion      String
  tipo             TipoPregunta
  respuestaAbierta String? @db.LongText

  itemEstudianteId  Int?
  itemEstudiante    ItemEncuestaEstudiante? @relation(fields: [itemEstudianteId], references: [id])

  itemColaboradorId Int?
  itemColaborador   ItemEncuestaColaborador? @relation(fields: [itemColaboradorId], references: [id])

  alternativas Alternativa[]
  respuestas   RespuestaSeleccionada[]

  @@map("pregunta")
}

model Alternativa {
  id          Int    @id @default(autoincrement())
  descripcion String
  puntaje     Int

  preguntaId Int
  pregunta   Pregunta @relation(fields: [preguntaId], references: [id])

  respuestas RespuestaSeleccionada[]

  @@map("alternativa")
}

///////////////////////////////
//   NUEVO MODELO: RESPUESTAS
///////////////////////////////

model RespuestaSeleccionada {
  id                    Int      @id @default(autoincrement())

  encuestaEstudianteId  Int?
  encuestaEstudiante    EncuestaEstudiante? @relation(fields: [encuestaEstudianteId], references: [id], onDelete: Cascade)

  encuestaColaboradorId Int?
  encuestaColaborador   EncuestaColaborador? @relation(fields: [encuestaColaboradorId], references: [id], onDelete: Cascade)

  preguntaId            Int
  pregunta              Pregunta @relation(fields: [preguntaId], references: [id])

  alternativaId         Int?
  alternativa           Alternativa? @relation(fields: [alternativaId], references: [id])

  respuestaAbierta      String? @db.LongText

  @@map("respuesta_seleccionada")
}

/////////////////////////////////////
//   HISTORIAL DE ESTUDIANTE
/////////////////////////////////////

model HistorialEvento {
  id             Int        @id @default(autoincrement())
  estudianteRut  String
  estudiante     Estudiante @relation(fields: [estudianteRut], references: [rut], onDelete: Cascade)
  fecha          DateTime   @default(now())
  tipo           String
  titulo         String?
  descripcion    String?    @db.Text
  responsable    String?
  createdAt      DateTime   @default(now())

  @@index([estudianteRut, fecha])
  @@map("historial_evento")
}

/////////////////////////////////////
//   PRACTICAS, CARGOS Y TUTORES
/////////////////////////////////////

model Tutor {
  id                 Int     @id @default(autoincrement())
  rut                String  @unique
  nombre             String
  correo             String?
  direccion          String?
  telefono           Int?
  universidad_egreso String?

  cargos          Cargo[]
  practicaTutores PracticaTutor[]

  @@map("tutor")
}

model CartaSolicitud {
  id               Int      @id @default(autoincrement())
  numero_folio     String   @unique
  fecha            DateTime
  direccion_emisor String?
  url_archivo      String?

  @@map("carta_solicitud")
}

model PracticaColaborador {
  practicaId    Int
  colaboradorId Int

  practica    Practica    @relation(fields: [practicaId], references: [id], onDelete: Cascade)
  colaborador Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  @@id([practicaId, colaboradorId])
  @@map("practica_colaborador")
}

model PracticaTutor {
  practicaId Int
  tutorId    Int
  rol        TipoTutor

  practica Practica @relation(fields: [practicaId], references: [id], onDelete: Cascade)
  tutor    Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@id([practicaId, tutorId])
  @@map("practica_tutor")
}

model Cargo {
  id    Int    @id @default(autoincrement())
  cargo String

  tutorId Int?
  tutor   Tutor? @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  colaboradorId Int?
  colaborador   Colaborador? @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  @@map("cargo")
}

model Observacion {
  id          Int      @id @default(autoincrement())
  descripcion String   @db.Text
  fecha       DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  practicaId Int
  practica   Practica @relation(fields: [practicaId], references: [id], onDelete: Cascade)

  @@map("observacion")
}
model ActividadVinculacion {
  id Int @id @default(autoincrement())

  // tipo de actividad (controlado por front)
  tipoActividad String // "Feria Vocacional" | "Jornada Pedagogica" | "Taller Remedial" | "Congreso Academico" | "Alternancia Pedagogica" | "Salida a Terreno"

  nombre      String
  objetivo    String
  descripcion String

  tipoVinculacion String
  areaVinculacion String
  areaImpacto     String
  sede            String

  fechaInicio  DateTime
  fechaTermino DateTime

  lugar    String?
  ingresos Int @default(0)

  proyecto   String?
  resultados String?

  // difusion (1:1 embebida)
  medioDifusion String?
  urlDifusion   String?

  // evidencias (texto)
  enlaceNoticia String?
  observaciones String?

  // Campos condicionales segun tipoActividad

  // Feria Vocacional
  institucionVisitada String?

  // Jornada Pedagogica
  temaCentral       String?
  talleres          String?
  responsableTaller String?

  // Taller Remedial
  asignaturaRemedial            String?
  competenciaAReforzar          String?
  numeroEstudiantesBeneficiados Int?

  // Congreso Academico
  nombreEvento       String?
  ponenciaPresentada String?
  relator            String?

  // Alternancia Pedagogica
  colegioAsociado            String?
  docenteColaborador         String?
  asignaturaAlternancia      String?
  curso                      String?
  docenteAsignatura          String?
  nombreActividadAlternancia String?

  // Salida a Terreno
  objetivoPedagogico  String?
  asignaturaVinculada String?
  profesorResponsable String?

  creadoEn    DateTime @default(now())
  actualizado DateTime @updatedAt

  // relaciones 1:N
  unidades              UnidadVinculacion[]
  responsables          ResponsableVinculacion[]
  equiposTrabajo        EquipoTrabajoVinculacion[]
  financiamientos       FinanciamientoVinculacion[]
  centrosCosto          CentroCostoVinculacion[]
  matricesParticipantes MatrizParticipantesVinculacion[]
  instituciones         InstitucionVinculacion[]
  archivosEvidencia     ArchivoEvidenciaVinculacion[]
  estudiantes           EstudianteActividadVinculacion[]

  @@map("actividad_vinculacion")
}

model UnidadVinculacion {
  id     Int    @id @default(autoincrement())
  codigo String
  nombre String

  actividadVinculacionId Int
  actividadVinculacion   ActividadVinculacion @relation(fields: [actividadVinculacionId], references: [id], onDelete: Cascade)

  @@map("actividad_vinculacion_unidad")
}

model ResponsableVinculacion {
  id     Int    @id @default(autoincrement())
  rut    String
  nombre String
  tipo   String // INTERNO | EXTERNO

  actividadVinculacionId Int
  actividadVinculacion   ActividadVinculacion @relation(fields: [actividadVinculacionId], references: [id], onDelete: Cascade)

  @@map("actividad_vinculacion_responsable")
}

model EquipoTrabajoVinculacion {
  id     Int    @id @default(autoincrement())
  rut    String
  nombre String
  equipo String

  actividadVinculacionId Int
  actividadVinculacion   ActividadVinculacion @relation(fields: [actividadVinculacionId], references: [id], onDelete: Cascade)

  @@map("actividad_vinculacion_equipo_trabajo")
}

model FinanciamientoVinculacion {
  id        Int    @id @default(autoincrement())
  categoria String
  tipo      String
  monto     Int

  actividadVinculacionId Int
  actividadVinculacion   ActividadVinculacion @relation(fields: [actividadVinculacionId], references: [id], onDelete: Cascade)

  @@map("actividad_vinculacion_financiamiento")
}

model CentroCostoVinculacion {
  id     Int    @id @default(autoincrement())
  nombre String

  actividadVinculacionId Int
  actividadVinculacion   ActividadVinculacion @relation(fields: [actividadVinculacionId], references: [id], onDelete: Cascade)

  @@map("actividad_vinculacion_centro_costo")
}

model MatrizParticipantesVinculacion {
  id Int @id @default(autoincrement())

  tipoParticipante String // ASISTENTE | EXPOSITOR

  directivosUta          Int @default(0)
  docentesUta            Int @default(0)
  estudiantesUta         Int @default(0)
  funcionariosGestionUta Int @default(0)
  exalumnos              Int @default(0)
  otrosExternos          Int @default(0)

  actividadVinculacionId Int
  actividadVinculacion   ActividadVinculacion @relation(fields: [actividadVinculacionId], references: [id], onDelete: Cascade)

  @@unique([actividadVinculacionId, tipoParticipante])

  @@map("actividad_vinculacion_matriz_participantes")
}

model InstitucionVinculacion {
  id     Int    @id @default(autoincrement())
  tipo   String
  nombre String

  actividadVinculacionId Int
  actividadVinculacion   ActividadVinculacion @relation(fields: [actividadVinculacionId], references: [id], onDelete: Cascade)

  @@map("actividad_vinculacion_institucion")
}

model ArchivoEvidenciaVinculacion {
  id Int @id @default(autoincrement())

  actividadVinculacionId Int
  actividadVinculacion   ActividadVinculacion @relation(fields: [actividadVinculacionId], references: [id], onDelete: Cascade)

  tipo   String  // LISTA_ASISTENCIA | DOCUMENTO | FOTOGRAFIA
  url    String  // ruta/url del archivo en tu servidor
  nombre String? // opcional para mostrar

  creadoEn DateTime @default(now())

  @@map("actividad_vinculacion_archivo_evidencia")
}

model EstudianteActividadVinculacion {
  id Int @id @default(autoincrement())

  rut    String
  nombre String

  actividadVinculacionId Int
  actividadVinculacion   ActividadVinculacion @relation(fields: [actividadVinculacionId], references: [id], onDelete: Cascade)

  @@map("actividad_vinculacion_estudiante")
}